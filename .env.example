# ── WooCommerce headless backend ──────────────────────────────────
# HTTPS base URL of the WordPress/WooCommerce backend (not the public portal).
WOOCOMMERCE_URL=https://backend-wholesale.mayaherbs.com

# Public retail catalog used only to enrich matching wholesale products with image galleries.
RETAIL_WOOCOMMERCE_URL=https://mayaherbs.com

# REST API keys — generate in WP Admin: WooCommerce > Settings > Advanced > REST API.
# The Maya Herbs key requires "Read/Write" permission because the portal reads the catalog and creates orders.
# These are SERVER-ONLY secrets (no NEXT_PUBLIC_ prefix) and never reach the browser.
WOOCOMMERCE_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: how long (seconds) the server caches WooCommerce responses. Default: 300.
WC_REVALIDATE_SECONDS=300
# Optional timeout for each upstream WooCommerce request in milliseconds. Default: 15000.
WC_REQUEST_TIMEOUT_MS=15000

# Checkout page path used to build secure "Pay for order" links. The portal
# automatically enables card payments only when the WooCommerce gateway
# `bunq_payment_2000` is installed and enabled.
WOOCOMMERCE_CHECKOUT_PATH=/checkout

# Required for production webhooks: shared secret used to verify product and
# customer events sent to https://wholesale.mayaherbs.com/api/webhooks/woocommerce.
# PDF exports always bypass the cache; product events also refresh the on-screen
# catalog immediately.
WC_WEBHOOK_SECRET=

# Transactional account and lead-time emails. RESEND_API_KEY and a sender on a
# domain verified in Resend are required. PORTAL_URL is used by account emails.
RESEND_API_KEY=
TRANSACTIONAL_EMAIL_FROM=Maya Herbs Wholesale <wholesale@mayaherbs.com>
TRANSACTIONAL_EMAIL_REPLY_TO=info@mayaherbs.com
# Internal recipient notified when a new wholesale application is submitted.
APPLICATION_NOTIFICATION_TO=sales@mayaherbs.com
LEAD_TIME_REQUEST_TO=sales@mayaherbs.com
PORTAL_URL=https://wholesale.mayaherbs.com

# WordPress admin Application Password — used to flag newly registered
# accounts with the "pending" role and to store partner profile photos in the
# WordPress media library. Generate it in WP Admin > Users > Profile >
# Application Passwords. Profile photo upload is unavailable without it.
WP_ADMIN_USER=
WP_APP_PASSWORD=

# Required: signs the HttpOnly authentication cookie. Generate a unique value
# with at least 32 random characters (for example: openssl rand -base64 48).
# Never prefix this variable with NEXT_PUBLIC_.
SESSION_SECRET=

# Optional local-only portal access. This account is accepted only by the
# development server when the request hostname is localhost/127.0.0.1.
LOCAL_DEV_LOGIN_ENABLED=false
LOCAL_DEV_AUTO_LOGIN=false
LOCAL_DEV_LOGIN_EMAIL=developer@maya.local
LOCAL_DEV_LOGIN_PASSWORD=

# Optional. Development falls back to this snapshot when WooCommerce is
# temporarily unavailable. Run `npm run catalog:snapshot` while the local
# server can reach WooCommerce to refresh it.
CATALOG_SNAPSHOT_PATH=tmp/catalog-snapshot.json

# Server-only text appended to new wholesale orders. Keep banking/payment data
# in Vercel Environment Variables instead of committing it to the repository.
# Use \n for line breaks when entering a single-line environment value.
WHOLESALE_ORDER_NOTE=
